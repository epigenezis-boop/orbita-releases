{
  "name": "orbita-player-alpha",
  "version": "2.0.0-alpha.1",
  "description": "Orbita Alpha personal music station",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "test:ui": "node test/refined-ui.cjs",
    "test:audio": "node test/audio-runtime.cjs"
  },
  "keywords": [],
  "author": "Personal project",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "music-metadata": "^11.13.0"
  },
  "productName": "Orbita Alpha",
  "repository": {
    "type": "git",
    "url": "https://github.com/epigenezis-boop/orbita-releases.git"
  },
  "build": {
    "appId": "Orbita.Player.Alpha",
    "productName": "Orbita Alpha",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.ico",
      "artifactName": "Orbita-Alpha-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Orbita Alpha",
      "uninstallDisplayName": "Orbita Alpha"
    },
    "publish": null
  }
}
